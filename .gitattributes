# Markdown uses two trailing spaces for intentional hard line breaks.
*.md whitespace=-blank-at-eol

# Distributed PWA assets are hashed byte-for-byte in public/asset-manifest.json.
# Any end-of-line conversion would change their size and sha256 on one platform
# only, so the manifest generated on Windows would never match the bytes served
# from a Linux build. Treat every shipped asset as binary.
*.svg -text
*.webp -text
*.png -text
*.ogg -text
*.mp3 -text
*.wav -text
*.woff2 -text
*.bin -text
public/pwa-bundles/*.json -text

# Preserve the upstream OFL notices byte-for-byte, including their trailing space.
public/fonts/v100/OFL-BIZUDPGothic.txt -text whitespace=-blank-at-eol
public/fonts/v100/OFL-Rajdhani.txt -text whitespace=-blank-at-eol
public/fonts/v100/OFL-ZenKakuGothicNew.txt -text whitespace=-blank-at-eol

# The generated distribution manifest itself must stay byte-identical across
# platforms so its drift check is meaningful.
public/asset-manifest.json -text

# The crawler provenance is generated as canonical LF JSON and checked by raw
# bytes. Keep a Windows checkout from rewriting it to CRLF before the
# deterministic generator comparison runs.
